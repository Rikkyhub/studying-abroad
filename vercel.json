{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "^/research/africa-trip(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/research/archive-africa-trip.html"
      }
    },
    {
      "src": "^/research/may-three-routes-comparison(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/research/archive-may-three-routes-comparison.html"
      }
    },
    {
      "src": "^/research/africa-2027-may-three-route-deep-research(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/research/archive-africa-2027-may-three-route-deep-research.html"
      }
    },
    {
      "src": "^/research/d-plan-no-namibia(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/research/archive-d-plan-no-namibia.html"
      }
    },
    {
      "src": "^/research/may-itinerary-nbo-to-cpt(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/research/archive-may-itinerary-nbo-to-cpt.html"
      }
    },
    {
      "src": "^/research/kenya-nairobi-short-stay(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/research/archive-kenya-nairobi-short-stay.html"
      }
    },
    {
      "src": "^/research/country-lesotho(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/lesotho.html"
      }
    },
    {
      "src": "^/research/country-eswatini(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/eswatini.html"
      }
    },
    {
      "src": "^/research/country-botswana(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/botswana.html"
      }
    },
    {
      "src": "^/research/country-zimbabwe(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/zimbabwe.html"
      }
    },
    {
      "src": "^/research/country-zambia(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/zambia.html"
      }
    },
    {
      "src": "^/research/country-mozambique(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/mozambique.html"
      }
    },
    {
      "src": "^/research/country-madagascar(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/madagascar.html"
      }
    },
    {
      "src": "^/research/country-kenya(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/kenya.html"
      }
    },
    {
      "src": "^/research/country-tanzania(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/tanzania.html"
      }
    },
    {
      "src": "^/research/country-ethiopia(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/ethiopia.html"
      }
    },
    {
      "src": "^/research/country-uganda(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/uganda.html"
      }
    },
    {
      "src": "^/research/country-rwanda(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/rwanda.html"
      }
    },
    {
      "src": "^/research/country-malawi(\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/countries/malawi.html"
      }
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/(all|docs-all)$",
      "dest": "/all.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
