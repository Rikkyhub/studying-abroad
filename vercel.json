{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "dest": "/app.html"
    },
    {
      "src": "^/docs-all$",
      "dest": "/all.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
